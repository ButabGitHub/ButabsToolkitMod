[sub_resource type="GDScript" id="GDScript_wrnp8"]
script/source = "extends OtherCornerButton


func _on_toggled(button_pressed : bool) -> void:
	if button_pressed == true:
		$\"../../ToolkitPanel\".show()
		self_modulate = Color(1,1,1,1)
	else:
		$\"../../ToolkitPanel\".hide()
		self_modulate = Color(1,1,1,NORMAL_OPACITY)
"

