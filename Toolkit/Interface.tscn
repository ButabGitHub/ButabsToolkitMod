[sub_resource type="GDScript" id="GDScript_dwlf1"]
script/source = "extends HBoxContainer

func _ready()-> void:
	await(Bopimo.active_playfield.ready)
	Bopimo.active_playfield.connect(\"change_apply_buttons_visibility\",(func(vis:bool)->void: self.visible=vis) as Callable)

func _on_apply_pressed() -> void:
	Bopimo.active_playfield.apply_changes()
	Bopimo.client.ui.configure_panel.close()


func _on_cancel_pressed() -> void:
	Bopimo.active_playfield.cancel_changes()
	Bopimo.client.ui.configure_panel.close()
"

