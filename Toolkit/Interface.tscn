[sub_resource type="GDScript" id="GDScript_72acx"]
resource_name = "ThemeButton"
script/source = "extends Button

func _on_pressed() -> void:
	#sAutoload.gumm.replace_resource_at(\"res://addons/BopimoTheme/Resources/BopimoTheme.tres\", sAutoload.gumm.load_resource(\"mod://Themes/BopimoTheme.tres\"))
	save_to_file(\"BopimoTheme.tres\")

func save_to_file(content : String):
	var file = FileAccess.open(\"user://mods/ButabsToolkitMod/current_theme.dat\", FileAccess.WRITE)
	file.store_string(content)
"

